{
  "name": "@volcanium/volcanium-components",
  "version": "3.15.0",
  "description": "UI Components Library for Volcanium",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "./src/index.css",
  "files": [
    "dist",
    "src/index.css"
  ],
  "exports": {
    "./rich-text": {
      "types": {
        "import": "./dist/rich-text.d.mts",
        "require": "./dist/rich-text.d.ts"
      },
      "import": "./dist/rich-text.mjs",
      "require": "./dist/rich-text.js",
      "default": "./dist/rich-text.mjs"
    },
    "./calendar": {
      "types": {
        "import": "./dist/calendar.d.mts",
        "require": "./dist/calendar.d.ts"
      },
      "import": "./dist/calendar.mjs",
      "require": "./dist/calendar.js",
      "default": "./dist/calendar.mjs"
    },
    "./contacts": {
      "types": {
        "import": "./dist/contacts.d.mts",
        "require": "./dist/contacts.d.ts"
      },
      "import": "./dist/contacts.mjs",
      "require": "./dist/contacts.js",
      "default": "./dist/contacts.mjs"
    },
    "./lib": {
      "types": {
        "import": "./dist/lib.d.mts",
        "require": "./dist/lib.d.ts"
      },
      "import": "./dist/lib.mjs",
      "require": "./dist/lib.js",
      "default": "./dist/lib.mjs"
    },
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./index.css": {
      "style": "./src/index.css",
      "import": "./src/index.css",
      "default": "./src/index.css"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.6.18",
    "@tabler/icons-react": "^3.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "esbuild": "^0.28.1",
    "framer-motion": "^11.3.30",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "postcss": "^8.5.25",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.26.1",
    "storybook": "^8.6.18",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.2.4",
    "typescript": "5.6.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@squircle-js/react": "^1.3.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0"
  }
}
